# Copiar a /opt/confianza/.env y ajustar
BASE_URL=https://verificar.tudominio.com.ar
NOMBRE_PLATAFORMA=Estudio de Confianza
PKI_DIR=/opt/confianza/pki
DATOS_DIR=/opt/confianza/datos
SALIDA_DIR=/opt/confianza/salida
# Clave de los .p12 de la PKI de prueba. En producción: PKCS#11 / HSM.
PKI_PASS=cambiar-esta-clave
# TSA RFC 3161. freetsa.org sirve para probar; para producción usar una TSA comercial.
TSA_URL=https://freetsa.org/tsr
